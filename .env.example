# 空欄ならWebサンプルは自己送金モードです。
# OpenCodeエージェント決済を使う場合は、固定のBase Sepolia受取アドレス (0x...) を設定してください。
X402_PAY_TO=

# OpenCode MCPクライアントが接続するSignal JournalのURL。
X402_DEMO_URL=http://localhost:3000

# 汎用x402 MCPがアクセス可能なHTTP origin。カンマ区切りで追加できます。
# 未指定の場合はX402_DEMO_URLと同一originだけを許可します。
X402_ALLOWED_ORIGINS=http://localhost:3000

# 公式テストネット facilitator。通常は変更不要です。
X402_FACILITATOR_URL=https://x402.org/facilitator

# スマホのウォレットアプリとWalletConnectで接続する場合に設定します。
# https://cloud.walletconnect.com/ で取得したProject IDを入力してください。
VITE_WALLETCONNECT_PROJECT_ID=
