# 空欄なら記事を購入するウォレット自身を受取先にします（自己送金PoC）。
# 固定のBase Sepolia受取アドレスを指定する場合は 0x... を設定してください。
X402_PAY_TO=

# 公式テストネット facilitator。通常は変更不要です。
X402_FACILITATOR_URL=https://x402.org/facilitator

# スマホのウォレットアプリとWalletConnectで接続する場合に設定します。
# https://cloud.walletconnect.com/ で取得したProject IDを入力してください。
VITE_WALLETCONNECT_PROJECT_ID=
