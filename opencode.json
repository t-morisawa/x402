{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "mocksearch": {
      "type": "local",
      "command": ["node", "--import", "tsx", "search-mcp/src/index.ts"],
      "cwd": ".",
      "enabled": true
    },
    "x402http": {
      "type": "local",
      "command": ["node", "--import", "tsx", "x402-http-mcp/src/index.ts"],
      "cwd": ".",
      "enabled": true
    }
  },
  "permission": {
    "x402http_fetch_url": "ask",
    "x402http_acp_complete_checkout": "ask",
    "x402http_mandate_create": "ask",
    "x402http_acp_complete_checkout_with_mandate": "allow"
  }
}
